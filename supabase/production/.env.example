# n8n Production Environment Template
# Copy to .env and fill in all values

# n8n Host (must be a real domain with SSL)
N8N_HOST=n8n.yourdomain.com

# PostgreSQL for n8n (internal to docker-compose)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# n8n Encryption Key (32 chars, used to encrypt credentials)
# Generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_STRING

# Optional: n8n Basic Auth (recommended for production)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional: Email for n8n notifications
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.yourprovider.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your-smtp-user
# N8N_SMTP_PASSWORD=your-smtp-password
# N8N_SMTP_SENDER="Hasad ERP <noreply@yourdomain.com>"